# Private keys and certificates
certs/*.key
certs/*.pem
certs/*.crt
certs/*.p12
certs/*.pfx

# Environment secrets
.env
.env.*

# Allow example environment files
!.env.example

# Generated data and logs
data/
logs/

# Private keys and generated certificates
certs/*.key
certs/*.pem
certs/*.crt
certs/*.csr
certs/*.srl
certs/*.p12
certs/*.pfx

# Generated certificate configuration and secrets
certs/private/
.env
.env.*

# Runtime data
data/
logs/

# Never commit generated certificate material
/certs/
